"s-lib1":{"x":2820,"y":1264,"w":360,"text":"Profile stats double as shortcuts: Designs opens My Designs, Favourites opens the Favourites tab. Sign-in buttons are placeholders — use Apple's and Google's official button assets.","page":"library"},
