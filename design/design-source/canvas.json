"s-ed1":{"x":2820,"y":0,"w":360,"text":"§8.1 — The dock, panels and photo-order strip sit above the system navigation inset (24 px gesture bar; 48 px with 3-button nav).","page":"editor"},
"s-ed2":{"x":2820,"y":520,"w":360,"text":"§8.2 — A photo spot that spans two slides gets its own + on each slide, plus a label naming the slides it covers. Neighbouring slides peek in, dimmed, so photos that cross an edge are visible.","page":"editor"},
"s-ed3":{"x":2820,"y":1264,"w":360,"text":"Handles are drawn small but get 44 px hit areas. Side handles hide when that side is under 110 px. The action pill and rotate button never cover the photo being edited.","page":"editor"},
"s-ed4":{"x":2820,"y":2528,"w":360,"text":"Sheets ride above the system keyboard while typing, and the slide scales down so it stays visible above any open sheet.","page":"editor"},
"t-ex1":{"x":0,"y":-300,"text":"Export flow — replaces today's alerts","kind":"title1","maxW":1790,"page":"export"},
