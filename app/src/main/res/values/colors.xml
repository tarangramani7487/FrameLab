<?xml version="1.0" encoding="utf-8"?>
<!-- FrameLab colour tokens. Names match HANDOFF.md §3. -->
<resources>
    <!-- Light surfaces — Home, Explore, My Designs, Profile -->
    <color name="fl_ink">#FF16130F</color> <!-- Primary text, dark cards, dark buttons -->
    <color name="fl_paper">#FFFAF7F2</color> <!-- App background (light side) -->
    <color name="fl_card">#FFFFFFFF</color> <!-- Cards, fields, tab bar, light sheets -->
    <color name="fl_muted">#FF6F685E</color> <!-- Secondary text (5.1:1 on paper) — replaces #8A8378 -->
    <color name="fl_line">#FFECE6DC</color> <!-- Borders, dividers -->
